# Copy to .env in the repo root (or in backend/). Never commit .env.

# ---- which implementation to use -------------------------------------------
LLM_PROVIDER=ollama            # ollama | azure_foundry
VECTOR_PROVIDER=chroma         # chroma | azure_search | memory
SECRETS_PROVIDER=env           # env | keyvault

# ---- local: Ollama (run `ollama list` and match these names) ----------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct-q8_0

# ---- local: storage ---------------------------------------------------------
CHROMA_PATH=./.chroma
SQLITE_PATH=./aria.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# ---- agent behaviour --------------------------------------------------------
RETRIEVAL_K=4
RETRIEVAL_MIN_SCORE=0.25
PROACTIVE_ENABLED=true
PROACTIVE_EVERY_N=4
PROACTIVE_COOLDOWN_S=90

# ---- web --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- cloud: Azure (only when running against Azure) -------------------------
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_CHAT_DEPLOYMENT=
AZURE_FOUNDRY_EMBED_DEPLOYMENT=
AZURE_FOUNDRY_API_VERSION=2024-10-21
AZURE_EMBED_DIM=1536
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=aria-docs
AZURE_KEYVAULT_URL=

# ---- secrets: ONLY for SECRETS_PROVIDER=env (e.g. running the eval against Azure) --
# In Azure these live in Key Vault as azure-foundry-api-key / azure-search-key.
AZURE_FOUNDRY_API_KEY=
AZURE_SEARCH_KEY=
